{
  "name": "vscode-maximize",
  "displayName": "Maximize Editor, Terminal & Chat",
  "description": "Maximize whatever has focus (an editor, the terminal panel, or a chat in the secondary side bar) with one key or one button, and restore the layout the same way.",
  "version": "0.3.1",
  "publisher": "lucidsleep",
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#16161a",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lucidSleep/vscode-maximize.git"
  },
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "maximize",
    "zen mode",
    "layout",
    "terminal",
    "panel"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "test": "node --test",
    "check": "tsc -p jsconfig.json",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "~1.140.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "~5.9.3"
  },
  "contributes": {
    "commands": [
      {
        "command": "maximize.maximizeEditor",
        "title": "Maximize Editor",
        "category": "Maximize",
        "icon": "$(screen-full)"
      },
      {
        "command": "maximize.maximizeEditorGroupMaximized",
        "title": "Maximize Editor",
        "category": "Maximize",
        "icon": "$(screen-full)"
      },
      {
        "command": "maximize.maximizePanel",
        "title": "Maximize Panel (Full Window)",
        "category": "Maximize",
        "icon": "$(screen-full)"
      },
      {
        "command": "maximize.toggleSecondarySideBar",
        "title": "Toggle Maximized Secondary Side Bar",
        "category": "Maximize"
      },
      {
        "command": "maximize.restore",
        "title": "Restore Layout",
        "category": "Maximize",
        "icon": "$(screen-normal)"
      },
      {
        "command": "maximize.restoreGroupMaximized",
        "title": "Restore Layout",
        "category": "Maximize",
        "icon": "$(screen-normal)"
      },
      {
        "command": "maximize.restorePanelMaximized",
        "title": "Restore Layout",
        "category": "Maximize",
        "icon": "$(screen-normal)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "maximize.maximizeEditor",
          "when": "!inZenMode && !panelMaximized"
        },
        {
          "command": "maximize.maximizeEditorGroupMaximized",
          "when": "false"
        },
        {
          "command": "maximize.maximizePanel",
          "when": "!inZenMode && !panelMaximized && (panelAlignment == 'center' || (panelPosition != 'bottom' && panelPosition != 'top'))"
        },
        {
          "command": "maximize.toggleSecondarySideBar",
          "when": "false"
        },
        {
          "command": "maximize.restore",
          "when": "inZenMode && !panelMaximized && !editorPartMaximizedEditorGroup"
        },
        {
          "command": "maximize.restoreGroupMaximized",
          "when": "inZenMode && !panelMaximized && editorPartMaximizedEditorGroup"
        },
        {
          "command": "maximize.restorePanelMaximized",
          "when": "panelMaximized"
        }
      ],
      "editor/title": [
        {
          "command": "maximize.maximizeEditor",
          "group": "navigation@-1000",
          "when": "config.maximize.showButtons && config.maximize.editorButtonPosition != 'right' && !inZenMode && !editorPartMaximizedEditorGroup"
        },
        {
          "command": "maximize.maximizeEditorGroupMaximized",
          "group": "navigation@-1000",
          "when": "config.maximize.showButtons && config.maximize.editorButtonPosition != 'right' && !inZenMode && editorPartMaximizedEditorGroup"
        },
        {
          "command": "maximize.restore",
          "group": "navigation@-1000",
          "when": "config.maximize.showButtons && config.maximize.editorButtonPosition != 'right' && inZenMode && !editorPartMaximizedEditorGroup"
        },
        {
          "command": "maximize.restoreGroupMaximized",
          "group": "navigation@-1000",
          "when": "config.maximize.showButtons && config.maximize.editorButtonPosition != 'right' && inZenMode && editorPartMaximizedEditorGroup"
        },
        {
          "command": "maximize.maximizeEditor",
          "group": "navigation@1000",
          "when": "config.maximize.showButtons && config.maximize.editorButtonPosition == 'right' && !inZenMode && !editorPartMaximizedEditorGroup"
        },
        {
          "command": "maximize.maximizeEditorGroupMaximized",
          "group": "navigation@1000",
          "when": "config.maximize.showButtons && config.maximize.editorButtonPosition == 'right' && !inZenMode && editorPartMaximizedEditorGroup"
        },
        {
          "command": "maximize.restore",
          "group": "navigation@1000",
          "when": "config.maximize.showButtons && config.maximize.editorButtonPosition == 'right' && inZenMode && !editorPartMaximizedEditorGroup"
        },
        {
          "command": "maximize.restoreGroupMaximized",
          "group": "navigation@1000",
          "when": "config.maximize.showButtons && config.maximize.editorButtonPosition == 'right' && inZenMode && editorPartMaximizedEditorGroup"
        }
      ],
      "editor/title/context": [
        {
          "command": "maximize.maximizeEditor",
          "group": "9_maximize",
          "when": "!inZenMode && !editorPartMaximizedEditorGroup"
        },
        {
          "command": "maximize.maximizeEditorGroupMaximized",
          "group": "9_maximize",
          "when": "!inZenMode && editorPartMaximizedEditorGroup"
        },
        {
          "command": "maximize.restore",
          "group": "9_maximize",
          "when": "inZenMode && !editorPartMaximizedEditorGroup"
        },
        {
          "command": "maximize.restoreGroupMaximized",
          "group": "9_maximize",
          "when": "inZenMode && editorPartMaximizedEditorGroup"
        }
      ],
      "view/title": [
        {
          "command": "maximize.maximizePanel",
          "group": "navigation@-1000",
          "when": "config.maximize.showButtons && config.maximize.panelButtonPosition == 'left' && viewLocation == 'panel' && !inZenMode && !panelMaximized && (panelAlignment == 'center' || (panelPosition != 'bottom' && panelPosition != 'top'))"
        },
        {
          "command": "maximize.restorePanelMaximized",
          "group": "navigation@-1000",
          "when": "config.maximize.showButtons && config.maximize.panelButtonPosition == 'left' && viewLocation == 'panel' && panelMaximized"
        },
        {
          "command": "maximize.maximizePanel",
          "group": "navigation@1000",
          "when": "config.maximize.showButtons && config.maximize.panelButtonPosition != 'left' && viewLocation == 'panel' && !inZenMode && !panelMaximized && (panelAlignment == 'center' || (panelPosition != 'bottom' && panelPosition != 'top'))"
        },
        {
          "command": "maximize.restorePanelMaximized",
          "group": "navigation@1000",
          "when": "config.maximize.showButtons && config.maximize.panelButtonPosition != 'left' && viewLocation == 'panel' && panelMaximized"
        }
      ]
    },
    "keybindings": [
      {
        "command": "maximize.maximizeEditor",
        "key": "ctrl+m",
        "when": "!inZenMode && !panelMaximized && !panelFocus && !auxiliaryBarFocus && !auxiliaryBarMaximized && (editorAreaFocus || sideBarFocus || !auxiliaryBarVisible)"
      },
      {
        "command": "maximize.maximizePanel",
        "key": "ctrl+m",
        "when": "!inZenMode && !panelMaximized && panelFocus && (panelAlignment == 'center' || (panelPosition != 'bottom' && panelPosition != 'top'))"
      },
      {
        "command": "maximize.toggleSecondarySideBar",
        "key": "ctrl+m",
        "when": "!inZenMode && !panelMaximized && (auxiliaryBarFocus || auxiliaryBarMaximized || (auxiliaryBarVisible && !editorAreaFocus && !sideBarFocus && !panelFocus))"
      },
      {
        "command": "maximize.restorePanelMaximized",
        "key": "ctrl+m",
        "when": "panelMaximized"
      },
      {
        "command": "maximize.restoreGroupMaximized",
        "key": "ctrl+m",
        "when": "inZenMode && !panelMaximized && editorPartMaximizedEditorGroup"
      },
      {
        "command": "maximize.restore",
        "key": "ctrl+m",
        "when": "inZenMode && !panelMaximized && !editorPartMaximizedEditorGroup"
      }
    ],
    "configuration": {
      "title": "Maximize",
      "properties": {
        "maximize.showButtons": {
          "type": "boolean",
          "default": true,
          "order": 1,
          "markdownDescription": "Show the ⛶ *Maximize* and *Restore Layout* buttons in the editor and panel title bars. Turn it off to keep only the shortcut, the tab's right-click menu and the Command Palette.\n\nThe shortcut is `Ctrl+M` by default: [change it in Keyboard Shortcuts](command:workbench.action.openGlobalKeybindings?%5B%22maximize.%22%5D)."
        },
        "maximize.editorButtonPosition": {
          "type": "string",
          "enum": [
            "left",
            "right"
          ],
          "enumDescriptions": [
            "First in the row of buttons: always shown.",
            "Last in the row. VS Code shows at most 9 buttons there, so when other extensions add theirs it moves into the ⋯ menu."
          ],
          "default": "left",
          "order": 2,
          "markdownDescription": "Where the ⛶ *Maximize Editor* and *Restore Layout* buttons sit in the editor title bar."
        },
        "maximize.panelButtonPosition": {
          "type": "string",
          "enum": [
            "left",
            "right"
          ],
          "enumDescriptions": [
            "First among the buttons of the panel's view, the terminal's for example.",
            "Last among them, next to VS Code's own panel buttons."
          ],
          "default": "right",
          "order": 3,
          "markdownDescription": "Where the ⛶ *Maximize Panel (Full Window)* and *Restore Layout* buttons sit in the panel title bar."
        }
      }
    },
    "configurationDefaults": {
      "zenMode.fullScreen": false,
      "zenMode.centerLayout": false,
      "zenMode.showTabs": "multiple",
      "zenMode.hideLineNumbers": false,
      "zenMode.hideStatusBar": false,
      "zenMode.silentNotifications": false,
      "terminal.integrated.commandsToSkipShell": [
        "maximize.maximizeEditor",
        "maximize.maximizeEditorGroupMaximized",
        "maximize.maximizePanel",
        "maximize.toggleSecondarySideBar",
        "maximize.restore",
        "maximize.restoreGroupMaximized",
        "maximize.restorePanelMaximized"
      ]
    }
  }
}
